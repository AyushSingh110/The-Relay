# Copy to `.env` and fill in. `.env` is gitignored; never commit real values.
GROQ_API_KEY=
# scripted (offline, default) | standin | groq
PROVIDER_MODE=scripted
# Initial candidate only; final model chosen after the comparison in ARCHITECTURE.md section 10.
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1
STANDIN_URL=http://127.0.0.1:8001/openai/v1
# off | exact
CACHE_MODE=exact
# Hard cap on real Groq calls for any script run; 0 means no real calls allowed.
MAX_REAL_CALLS=0
# [PROPOSED] stop real runs at this fraction of known daily limits.
DAILY_SAFETY_FRACTION=0.75
