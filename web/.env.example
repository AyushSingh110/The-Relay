# Read by Vite at build time (`relay ui build` or `npm run build`). Values end up in the
# built JavaScript, so never put a real secret here.
# relay-dev-key is the development key: a server listening on loopback accepts it as the
# development tenant (V2-10). Anywhere else, use a key from `relay keys create`, and keep
# that build private. The tenant comes from the key; VITE_TENANT_ID is no longer sent.
VITE_API_KEY=relay-dev-key
VITE_TENANT_ID=dev
