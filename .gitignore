# --- Secrets (never commit) ---
.env
.env.*
!.env.example

# --- Python build / cache artefacts ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/
.cache/

# --- Local, regenerable working data ---
scratch/
data/papers/*.pdf
data/processed/
data/indexes/
data/models/
# v2 metadata store (runtime state, recreated by migrations): the database and its
# WAL / shared-memory side files.
data/*.sqlite3
data/*.sqlite3-wal
data/*.sqlite3-shm
# v2 uploaded PDFs (content-addressed by SHA-256; user data, not evidence)
data/uploads/
data/collections/
uv.lock
# NOTE: `results.csv` and everything under `evidence/` are submission evidence
# and are intentionally TRACKED. Do not add ignore rules for them.

# --- v2 web UI (V2-06): Node dependencies and the Vite build output ---
web/node_modules/
web/dist/

# --- Local-only project records (kept on the owner's machine, not published) ---
CLAUDE.md
.claude/
ENGINEERING_LOG.md
IMPLEMENTATION_PLAN.md
docs/IMPLEMENTATION_PLAN_V2.md
ASSIGNMENT.md
demo/
reports/

# --- Local tool output ---
.playwright-mcp/
